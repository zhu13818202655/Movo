          "fontWeight": "semibold"
        },
        {
          "type": "text",
          "id": "dwm0Q",
          "name": "说明",
          "fill": "$muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "筛选选中「今日」时，日期已知是今天，行内时间文字只显示时刻，不重复日期。同一任务的完整时间在任务详情页照常显示日期。规则是「只省略今天这个日期，不省略任何仍有信息量的日期」。重复行动行本来就只显示时刻，保持原样。",
          "lineHeight": 1.4,
          "fontFamily": "Noto Sans SC",
          "fontSize": 14,
